#!/usr/bin/env tclsh9

package require tcltest
package require json

namespace import ::tcltest::*

set current_dir [file dirname [file normalize [info script]]]
lappend ::auto_path [file dirname $current_dir]
package require tutils 1.0

set test_log_file [file join [pwd] "test.log"]

# ======================================================================
# 1. 基础日志系统生命周期测试
# ======================================================================

test log-init-1.1 {测试日志初始化} -body {
    log init $test_log_file INFO
    set fp [dict get $::log::db file_handle]
    expr {$fp ne ""}
} -result 1

test log-close-1.2 {测试日志关闭} -body {
    log close_file
    set fp [dict get $::log::db file_handle]
    expr {$fp eq ""}
} -result 1

# ======================================================================
# 2. 原生数据结构无脑美化打印测试 (dict / list)
# ======================================================================

test log-pdict-1.3 {测试 dict 转纯文本排版} -setup {
    log init $test_log_file INFO
} -body {
    set d [dict create key1 val1 key2 val2]
    set json [log pdict $d auto 0 4 0 json]
    log info "\n$json"
    string match {*"key1" : "val1"*} $json
} -cleanup {
    log close_file
} -result 1

test log-pdict-1.4 {测试 list 转纯文本排版} -setup {
    log init $test_log_file INFO
} -body {
    set l [list "a" "b" "c"]
    set json [log pdict $l auto 0 4 0 json]
    log info "\n$json"
    string match {*"a",*} $json
} -cleanup {
    log close_file
} -result 1

# ======================================================================
# 3. 复杂、极端嵌套结构测试
# ======================================================================

test log-pdict-1.5 {测试复杂嵌套：字典里嵌套列表} -setup {
    log init $test_log_file INFO
} -body {
    set d [dict create \
        project "EDA_Automation" \
        tags [list "debug" "core"] \
    ]
    set result [log pdict $d auto 0 4 0 json]
    log info "\n$result"
    
    expr {
        [string match {*"project" : "EDA_Automation",*} $result] && \
        [string match {*"tags" : \[*} $result] && \
        [string match {*"debug",*} $result] && \
        [string match {*"core"*} $result]
    }
} -cleanup {
    log close_file
} -result 1

test log-pdict-1.6 {测试复杂嵌套：列表中嵌套字典} -setup {
    log init $test_log_file INFO
} -body {
    set l [list \
        [dict create name "Tom" age 20] \
        [dict create name "Jack" age 25] \
    ]
    set result [log pdict $l auto 0 4 0 json]
    log info "\n$result"
    
    expr {
        [string match {*"name" : "Tom",*} $result] && \
        [string match {*"age" : "20"*} $result] && \
        [string match {*"name" : "Jack",*} $result]
    }
} -cleanup {
    log close_file
} -result 1

test log-pdict-1.7 {测试极端嵌套：多层深度树状套娃} -setup {
    log init $test_log_file DEBUG
} -body {
    set tree {
        root {
            layer1 {
                layer2 {
                    leaf "final_value"
                }
            }
        }
    }
    set result [log pdict $tree auto 0 4 0 tree]
    log debug "\n$result"
    puts "$tree"
    
    expr {
        [string match {*root*} $result] && \
        [string match {*layer1*} $result] && \
        [string match {*layer2*} $result] && \
        [string match {*\\\"final_value\\\"*} $result]
    }
} -cleanup {
    log close_file
} -result 1

# ======================================================================
# 4. 专属调用链与业务行号拦截测试（防污染隔离版）
# ======================================================================

proc ::func_layer_C {msg} { log error $msg }
proc ::func_layer_B {msg} { ::func_layer_C $msg }
proc ::func_layer_A {msg} { ::func_layer_B $msg }

test log-trace-1.8 {测试过程调用跟踪栈与动态行号标签（针对 WARN/ERROR）} -setup {
    set trace_file [file join [pwd] "trace_test.log"]
    log init $trace_file INFO
} -body {
    ::func_layer_A "触发恶意深层报错"
    log close_file
    set fp [open $trace_file r]
    fconfigure $fp -encoding utf-8
    set log_content [read $fp]
    close $fp
    
    expr {
        [string match {*在函数 ::func_layer_A*} $log_content] && \
        ![string match {*在函数 _write*} $log_content] && \
        [string match {*\[ERROR\]\[log.test:*\]-->*} $log_content]
    }
} -cleanup {
    catch {file delete -force $trace_file}
    log close_file
} -result 1

test log-trace-1.9 {测试极端无文件背景下的匿名调用（验证并拦截隐藏空行）} -setup {
    set trace_file [file join [pwd] "trace_empty_line_test.log"]
    log init $trace_file INFO
} -body {
    apply {{msg} { log error $msg }} "匿名炸弹"
    log close_file
    set fp [open $trace_file r]
    fconfigure $fp -encoding utf-8
    set log_content [read $fp]
    close $fp
    catch {file delete -force $trace_file}

    expr {
        [string match {*匿名炸弹*} $log_content] && \
        ![string match {*\n\n*} [string trim $log_content]]
    }
} -cleanup {
    log close_file
} -result 1

# ======================================================================
# 5. 符号引用嵌套与拓扑数据结构测试
# ======================================================================

test log-pdict-1.10 {测试符号引用：顶层键的值指向另一个键名，验证数据链的完整解析 (A -> B -> A)} -setup {
    set loop_file1 [file join [pwd] "loop_real_top.log"]
    log init $loop_file1 INFO
} -body {
    set top_dict1 [dict create \
        root_node1    "cluster_master" \
        self_link1    "包含\"双引号\"和\\反斜杠\\" \
        self_link2    "帶有\t制表符的文字" \
        self_link3    "含有\{花括號\}和\[中括號\]的危險字串" \
        self_link4    "    " \
        self_link5    "" \
        self_link6    "中文及特殊符號~!@#$%^&*()_+" \
        self_link7    "中文" \
        self_link8    "繁體\[中文\]\n\"測試\"[binary format c 0]\t結[binary format c 17]束[binary format c 2][binary format c 8]哈哈哈" \
        self_link9    [list] \
        self_link10   [dict create] \
        poison_bell   "物理響鈴符投毒\a" \
        poison_page   "物理翻頁符投毒\f" \
        poison_back   "物理退格符投毒\b" \
        poison_ret    "物理回車符投毒\r" \
        poison_ghost1 [binary format c 1] \
        poison_ghost2 [binary format c 27] \
        tcl_inject1   "注入惡意代碼:\$env(PATH)" \
        "tcl_inject2\n"   "注入執行指令:\[exit\]" \
        tcl_inject3   "注入複雜語法:\${some_ghost_var}" \
        scalar_int    [expr {42}] \
        scalar_float  [expr {3.1415926}] \
        scalar_bool   [expr {1 < 2}] \
        blob_stream   [binary format a4 "BLOB"] \
    ]
    set top_dict2 [dict create \
        root_node2 "cluster_slave" \
        self_link2 "" \
    ]

    dict set top_dict2 self_link2 $top_dict1
    dict set top_dict1 self_link1 $top_dict2

    log error "\n[log pdict $top_dict1 auto 0 4 0 json]"
    log error "\n[log pdict $top_dict2 auto 0 4 0 json]"
    
    log close_file
    
    set fp [open $loop_file1 r]
    fconfigure $fp -encoding utf-8
    set log_content [read $fp]
    close $fp

    expr {
        [string match {*"root_node2" : "cluster_slave*} $log_content] && \
        [string match {*"self_link2" : \{*} $log_content]
    }
} -cleanup {
    catch {file delete -force $loop_file1}
    log close_file
} -result 1

test log-pdict-1.11 {测试符号引用：多层深度符号链的垂直缩进规范性 (A -> B -> C)} -setup {
    set norm_file [file join [pwd] "norm_nest.log"]
    log init $norm_file INFO
} -body {
    set normal_tree {
        design_top {
            instance_A {
                ref_module "AND_GATE_X1"
                next_cell "instance_B"
            }
        }
    }
    set result [log pdict $normal_tree auto 0 4 0 json]
    log error "\n$result"
    
    log close_file
    
    set fp [open $norm_file r]
    fconfigure $fp -encoding utf-8
    set log_content [read $fp]
    close $fp

    expr {
        [string match {*design_top*} $log_content] && \
        [string match {*ref_module*} $log_content] && \
        [string match {*next_cell*} $log_content]
    }
} -cleanup {
    catch {file delete -force $norm_file}
    log close_file
} -result 1

test log-pdict-1.12 {测试树状样式：验证 tree 模式下业务数据末尾自带的逗号绝对不被误伤抹除} -setup {
    set tree_comma_file [file join [pwd] "tree_comma.log"]
    log init $tree_comma_file INFO
} -body {
    set comma_data [dict create \
        "pin_A,B" [dict create \
            "status" "connected" \
            "aliases" "clk_tree,sys_clk," \
        ] \
    ]
    
    set result [log pdict $comma_data "auto" 0 4 0 "tree"]
    log info "\n$result"
    
    log close_file
    
    set fp [open $tree_comma_file r]
    fconfigure $fp -encoding utf-8
    set log_content [read $fp]
    close $fp

    expr {
        [string match {*=>*} $log_content] && \
        [string match {*sys_clk,*} $log_content] && \
        [string match {*pin_A,B*} $log_content]
    }
} -cleanup {
    catch {file delete -force $tree_comma_file}
    log close_file
} -result 1

# ======================================================================
# 6. TclOO 对象内省与无闪烁测试（适配你的 <::类名> 格式）
# ======================================================================

test log-pdict-1.13 {测试 TclOO 对象：类、父类、变量及值均被打印} -setup {
    log init $test_log_file INFO
    oo::class create TutilsTestNode {
        variable name
        variable value
        constructor {n v} {
            set name $n
            set value $v
        }
    }
    set obj [TutilsTestNode new "alpha" 42]
} -body {
    catch { info object class $obj }
    set result [log pdict $obj auto 0 4 0 tree]
    log info "\n$result"
    
    # 用 regexp 精准匹配，避免 string match 的多行陷阱
    set c1 [regexp {"object"\s*:\s*"<::oo::Obj[^>]*>"} $result]
    set c2 [regexp {"class"\s*:\s*"<::TutilsTestNode>"} $result]
    set c3 [regexp {"superclasses"\s*:\s*"<::oo::object>"} $result]
    set c4 [regexp {"name"\s*:\s*"alpha"} $result]
    set c5 [regexp {"value"\s*:\s*"42"} $result]
    expr {$c1 && $c2 && $c3 && $c4 && $c5}
} -cleanup {
    catch { $obj destroy }
    catch { oo::class delete TutilsTestNode }
    log close_file
} -result 1

# ======================================================================
# 7. bytearray 安全预览与魔数识别测试
# ======================================================================

test log-pdict-1.14 {测试 bytearray：只输出头部十六进制，不输出完整二进制} -setup {
    log init $test_log_file INFO
} -body {
    set ba [binary format H* "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"]
    set result [log pdict $ba auto 0 4 0 tree]
    log info "\n$result"
    expr {
        [string match {*<bytearray len=32 head=16:*} $result] && \
        [string match {*...*} $result]
    }
} -cleanup {
    log close_file
} -result 1

test log-pdict-1.15 {测试 bytearray：字节 0x00 被正确编码为 "00"} -setup {
    log init $test_log_file INFO
} -body {
    set ba [binary format H* "4800656c6c6f"]
    set result [log pdict $ba auto 0 4 0 tree]
    log info "\n$result"
    string match {*48 00 65 6c 6c 6f*} $result
} -cleanup {
    log close_file
} -result 1

test log-pdict-1.16 {测试 bytearray：魔数识别 PNG} -setup {
    log init $test_log_file INFO
} -body {
    set ba [binary format H* "89504e470d0a1a0a0000000d4948445200000010"]
    set result [log pdict $ba auto 0 4 0 tree]
    log info "\n$result"
    string match {*type=PNG image*} $result
} -cleanup {
    log close_file
} -result 1

test log-pdict-1.17 {测试 bytearray：魔数识别 ZIP} -setup {
    log init $test_log_file INFO
} -body {
    set ba [binary format H* "504b0304140000000800f0a1b25a0000"]
    set result [log pdict $ba auto 0 4 0 tree]
    log info "\n$result"
    string match {*type=ZIP archive*} $result
} -cleanup {
    log close_file
} -result 1

test log-pdict-1.18 {测试 bytearray：未知数据不标注 type} -setup {
    log init $test_log_file INFO
} -body {
    set ba [binary format H* "48656c6c6f005c0a1b"]
    set result [log pdict $ba auto 0 4 0 tree]
    log info "\n$result"
    expr {
        [string match {*<bytearray len=9 head=9:*} $result] && \
        ![string match {*type=*} $result]
    }
} -cleanup {
    log close_file
} -result 1

test log-pdict-1.19 {测试 bytearray：内部表示不因 pdict 发生字符串化} -setup {
    log init $test_log_file INFO
} -body {
    set ba [binary format H* "48656c6c6f005c0a1b"]
    set before [tcl::unsupported::representation $ba]
    log pdict $ba auto 0 4 0 tree
    set after [tcl::unsupported::representation $ba]
    expr {
        [string match {*value is a bytearray*} $before] && \
        [string match {*no string representation*} $before] && \
        [string match {*value is a bytearray*} $after] && \
        [string match {*no string representation*} $after]
    }
} -cleanup {
    log close_file
} -result 1

# ======================================================================
# 8. get_type 顺序正确性（敏感类型先于 eq ""）
# ======================================================================

test get-type-1.20 {测试 get_type：bytearray 在 eq "" 之前被识别，不触发字符串化} -body {
    set ba [binary format H* "48656c6c6f005c0a1b"]
    set before [tcl::unsupported::representation $ba]
    set t [sys get_type $ba]
    set after [tcl::unsupported::representation $ba]
    expr {
        $t eq "bytearray" && \
        [string match {*no string representation*} $before] && \
        [string match {*no string representation*} $after]
    }
} -result 1

test get-type-1.21 {测试 get_type：cmdName 在 eq "" 之前被识别，不降级} -setup {
    oo::class create TutilsTestNode3 {
        variable x
        constructor {} { set x 1 }
    }
    set obj [TutilsTestNode3 new]
    catch { info object class $obj }
} -body {
    set before [tcl::unsupported::representation $obj]
    set t [sys get_type $obj]
    set after [tcl::unsupported::representation $obj]
    expr {
        $t eq "object" && \
        [string match {*value is a cmdName*} $before] && \
        [string match {*value is a cmdName*} $after]
    }
} -cleanup {
    catch { $obj destroy }
    catch { oo::class delete TutilsTestNode3 }
} -result 1

# ======================================================================
# 9. 混合嵌套：对象 + bytearray + dict/list
# ======================================================================

test log-pdict-1.22 {测试混合嵌套：dict/list 中同时挂载对象与 bytearray} -setup {
    log init $test_log_file INFO
    oo::class create TutilsTestNode4 {
        variable name
        constructor {n} { set name $n }
    }
    set obj [TutilsTestNode4 new "gamma"]
    catch { info object class $obj }
    set ba [binary format H* "89504e470d0a1a0a0000000d49484452"]
} -body {
    set data [dict create \
        id 100 \
        obj $obj \
        bin $ba \
        nested [list [dict create k1 v1] "plain"] \
    ]
    set result [log pdict $data auto 0 4 0 tree]
    log info "\n$result"
    expr {
        [string match {*"class" : "<::TutilsTestNode4>"*} $result] && \
        [string match {*<bytearray len=*type=PNG image*} $result] && \
        [string match {*"k1" : "v1"*} $result]
    }
} -cleanup {
    catch { $obj destroy }
    catch { oo::class delete TutilsTestNode4 }
    log close_file
} -result 1

# ======================================================================
# 10. 终极压力测试：平级重复引用、死循环、未唤醒对象、深水区
# ======================================================================

test log-pdict-1.23 {终极压力测试：平级重复、死循环、未唤醒、深水区} -setup {
    set stress_file [file join [pwd] "stress_test.log"]
    log init $stress_file INFO

    oo::class create Leaf {
        variable name
        constructor {n} { set name $n }
    }
    oo::class create CycleA {
        variable next
        method set_next {o} { set next $o }
    }
    oo::class create CycleB {
        variable next
        method set_next {o} { set next $o }
    }
    oo::class create Root {
        variable my_dict
        variable my_list
        constructor {d l} {
            set my_dict $d
            set my_list $l
        }
    }

    set shared_leaf [Leaf new "全图共享的叶子对象（我已醒）"]
    catch { info object class $shared_leaf }

    set sleeping_leaf [Leaf new "沉睡的叶子对象（我是字符串）"]

    set c_a [CycleA new]
    set c_b [CycleB new]
    $c_a set_next $c_b
    $c_b set_next $c_a
    catch { info object class $c_a }
    catch { info object class $c_b }

    set test_dict [dict create \
        "dict_key1" $shared_leaf \
        "dict_key2" $shared_leaf \
        "dict_key_cycle" $c_a \
        "dict_key_sleep" $sleeping_leaf \
    ]

    set test_list [list \
        "list_item1" \
        $shared_leaf \
        [dict create "deep_dict_key" $shared_leaf] \
    ]

    set root [Root new $test_dict $test_list]
    catch { info object class $root }
} -body {
    set result [log pdict $root auto 0 4 0 tree]
    log info "\n$result"
    
    expr {
        [regexp -all {全图共享的叶子对象（我已醒）} $result] == 4 && \
        [string match {*"status" : "<circular reference>"*} $result] && \
        [string match {*"dict_key_sleep" : "::oo::Obj*} $result]
    }
} -cleanup {
    catch { $root destroy }
    catch { $c_a destroy }
    catch { $c_b destroy }
    catch { $sleeping_leaf destroy }
    catch { $shared_leaf destroy }
    catch { oo::class delete Leaf }
    catch { oo::class delete CycleA }
    catch { oo::class delete CycleB }
    catch { oo::class delete Root }
    # 【核心修复】必须先关闭文件，再删除文件，否则 Windows 文件句柄被占用删不掉
    log close_file
    catch {file delete -force $stress_file}
} -result 1

test log-pdict-1.24 {测试普通命令被 get_type 误判为 object 时的兜底打印} -setup {
    log init $test_log_file INFO
    
    # 1. 内置命令 puts（正确摸醒）
    set cmd_builtin "puts"
    catch { $cmd_builtin "test" }

    # 2. 标准库命令 info
    set cmd_info "info"
    catch { $cmd_info version }

    # 3. 自定义 proc
    proc my_helper {x} { return $x }
    set cmd_proc "my_helper"
    catch { $cmd_proc 1 }
} -body {
    # 检查内部表示，确认已经被摸成 cmdName
    set rep_builtin [tcl::unsupported::representation $cmd_builtin]
    set rep_info    [tcl::unsupported::representation $cmd_info]
    set rep_proc    [tcl::unsupported::representation $cmd_proc]

    # 将这三个伪对象塞进字典
    set d [dict create \
        "builtin_cmd"  $cmd_builtin \
        "library_cmd"  $cmd_info \
        "user_proc"    $cmd_proc \
    ]

    set result [log pdict $d auto 0 4 0 tree]
    log info "\n$result"

    # 【硬核断言】
    # 1. 验证前置条件：这三个变量确实被摸成了 cmdName
    # 2. 验证兜底逻辑：三处都必须出现 <not a TclOO object>
    # 3. 验证错误信息：必须保留底层报错 details
    expr {
        [string match {*value is a cmdName*} $rep_builtin] && \
        [string match {*value is a cmdName*} $rep_info] && \
        [string match {*value is a cmdName*} $rep_proc] && \
        [regexp -all {"note"\s*:\s*"<not a TclOO object>"} $result] == 3 && \
        [string match {*"error" : "puts does not refer to an object"*} $result] && \
        [string match {*"error" : "info does not refer to an object"*} $result] && \
        [string match {*"error" : "my_helper does not refer to an object"*} $result]
    }
} -cleanup {
    catch { rename my_helper {} }
    log close_file
} -result 1


# 全局大清洗
catch {file delete -force $test_log_file}
cleanupTests

